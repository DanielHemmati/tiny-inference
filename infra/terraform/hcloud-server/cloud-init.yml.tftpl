#cloud-config

package_update: true

packages:
  - ca-certificates
  - curl

write_files:
  - path: /run/tailscale-auth-key
    owner: root:root
    permissions: "0600"
    content: |
      ${tailscale_auth_key}

runcmd:
  - curl -fsSL https://tailscale.com/install.sh | sh
  - tailscale up --auth-key=file:/run/tailscale-auth-key --hostname=$tailscale_hostname}
  - rm -f /run/tailscale-auth-key
